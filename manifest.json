{
  "manifest_version": 3,
  "name": "JD Keyword Analyzer",
  "version": "0.1.0",
  "description": "Analyze Indeed and LinkedIn job descriptions with lightweight keyword scoring.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "JD Keyword Analyzer",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "form-memory.js"
      ],
      "run_at": "document_idle",
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "all_frames": true
    }
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
